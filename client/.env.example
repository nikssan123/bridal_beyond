# API (optional; default used by Vite dev)
# VITE_API_URL=http://localhost:4000/api

# Stripe (publishable key for client-side Elements)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Google OAuth (optional; if set, Sign in with Google is shown on the login page)
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Meta (Facebook) OAuth (optional; if set, Sign in with Facebook is shown)
# VITE_META_APP_ID=your-meta-app-id
