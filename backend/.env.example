# Server
NODE_ENV=development
PORT=4000

# Database (Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bridal_beyond

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Google OAuth (required for POST /api/auth/google)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Meta (Facebook) OAuth (optional; leave empty to disable Meta login)
META_APP_ID=
META_APP_SECRET=

# CORS (comma-separated origins, or * for dev)
CORS_ORIGIN=http://localhost:3000

# Stripe Connect & payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PLATFORM_FEE_PERCENT=5
CLIENT_URL=http://localhost:3000
STRIPE_CURRENCY=eur
