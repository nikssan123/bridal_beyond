# Copy to .env.test and set values. Used when running backend tests (jest).
# Integration tests need a real test database; run: prisma migrate deploy (with DATABASE_URL pointing to test DB).

NODE_ENV=test
PORT=4001
DATABASE_URL=postgresql://user:password@localhost:5432/db_name
JWT_SECRET=test-jwt-secret-at-least-32-chars-long
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PERCENT=5
STRIPE_BUYER_FEE_PERCENT=5
STRIPE_FREE_SELLER_COMMISSION_ORDER_LIMIT=0
CLIENT_URL=http://localhost:5173
STRIPE_CURRENCY=eur
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
GOOGLE_CLIENT_ID=
META_APP_ID=
META_APP_SECRET=
